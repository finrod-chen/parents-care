---
interface Props { verifiedAt: string | null; sources: { label: string; url: string }[]; heading?: string }
const { verifiedAt, sources, heading = '官方來源' } = Astro.props;
---
<section aria-label="資料來源與查證日期" class="mt-8 rounded-2xl bg-teal-50 p-4 text-sm">
  <p><strong>資料最後查證：{verifiedAt ?? '—'}</strong></p>
  <p class="mt-1">
    {heading}：
    {sources.length === 0 ? '—' : sources.map((s, i) => (
      <>{i > 0 && '、'}<a class="text-brand-dark underline" href={s.url} rel="noopener">{s.label}</a></>
    ))}
  </p>
</section>
