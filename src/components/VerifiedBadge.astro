---
interface Props { verifiedAt: string | null; sources: { label: string; url: string }[]; heading?: string }
const { verifiedAt, sources, heading = '官方來源' } = Astro.props;
---
<section aria-label="資料來源與查證日期" class="mt-10 rounded-xl border border-line-subtle bg-surface p-4 text-sm text-text-secondary">
  <p><span class="font-medium text-foreground">資料最後查證：{verifiedAt ?? '無'}</span></p>
  <p class="mt-1">
    {heading}：
    {sources.length === 0 ? '無' : sources.map((s, i) => (
      <>{i > 0 && '、'}<a class="text-accent-strong underline underline-offset-2" href={s.url} rel="noopener">{s.label}</a></>
    ))}
  </p>
</section>
