---
import Base from '../layouts/Base.astro';
import Breadcrumb from './Breadcrumb.astro';
import CompareTable from './CompareTable.astro';
import VerifiedBadge from './VerifiedBadge.astro';
import { byTopic, overviewIndexable, isVerified } from '../lib/data';
import { countyName } from '../lib/counties';
import { topicOf, type TopicSlug } from '../lib/topics';
import { breadcrumbLd, webAppLd, withSite, type Crumb } from '../lib/seo';

interface Props { topic: TopicSlug; calculator?: boolean }
const { topic: slug, calculator = false } = Astro.props as Props;
const topic = topicOf(slug);
const entries = byTopic(slug);
const verifiedEntries = entries.filter(isVerified);
const path = `/${slug}/`;
const crumbs: Crumb[] = [{ name: '首頁', path: '/' }, { name: topic.title, path }];

const title = withSite(topic.overviewTitle);
const description = `${topic.intro}已查證 ${verifiedEntries.length} 個縣市，每筆附官方來源與查證日期。`;
const dates = verifiedEntries.map((e) => (e.status === 'verified' ? e.verified_at : '')).sort();
const sources = verifiedEntries.map((e) => ({ label: countyName(e.county), url: e.status === 'verified' ? e.source_url : '' }));
const jsonLd = [
  breadcrumbLd(crumbs),
  ...(calculator ? [webAppLd({ name: `${topic.title}試算`, path, description: `輸入縣市與年齡，試算可領的${topic.title}金額。` })] : []),
];
---
<Base title={title} description={description} path={path} noindex={!overviewIndexable(slug)} jsonLd={jsonLd}>
  <Breadcrumb crumbs={crumbs} />
  <h1 class="text-2xl font-bold">{topic.overviewTitle}</h1>
  <p class="mt-3 text-lg">{topic.intro}目前已查證 {verifiedEntries.length} / {entries.length} 個縣市，其餘標示「待查證」。</p>

  <slot />

  <section aria-labelledby="table-h" class="mt-8">
    <h2 id="table-h" class="text-xl font-bold mb-3">各縣市比較表</h2>
    <CompareTable entries={entries} />
  </section>

  <VerifiedBadge verifiedAt={dates[0] ?? null} sources={sources} />
</Base>
