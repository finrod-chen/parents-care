---
import type { Entry } from '../lib/data';
import { countyName } from '../lib/counties';
import DeadlineBadge from './DeadlineBadge.astro';
const { entries } = Astro.props as { entries: Entry[] };
---
<div class="overflow-x-auto">
  <table class="w-full min-w-[30rem] border-collapse text-left text-sm">
    <caption class="sr-only">各縣市比較表</caption>
    <thead>
      <tr class="bg-teal-100">
        <th scope="col" class="p-2">縣市</th>
        <th scope="col" class="p-2">項目與金額</th>
        <th scope="col" class="p-2">查證日</th>
      </tr>
    </thead>
    <tbody>
      {entries.map((e) => (
        <tr class="border-b border-teal-100 align-top">
          <th scope="row" class="p-2 font-medium">
            {e.status === 'verified' ? <a class="text-brand-dark underline" href={`/${e.topic}/${e.county}/`}>{countyName(e.county)}</a> : countyName(e.county)}
          </th>
          <td class="p-2">
            {e.status === 'verified'
              ? e.items.map((i) => <div>{i.name}：<strong>{i.amount ?? <span class="text-rose-700">待查證</span>}</strong> <DeadlineBadge date={i.deadline_date} /></div>)
              : <span class="text-rose-700">待查證</span>}
          </td>
          <td class="p-2 whitespace-nowrap">{e.verified_at ?? '待查證'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
