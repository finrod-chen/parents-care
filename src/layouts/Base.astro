---
import '../styles/global.css';
import { SITE_NAME } from '../lib/site';
import { absUrl, ldString } from '../lib/seo';
import { CREDIT } from '../lib/illustrations';

interface Props {
  title: string; // 完整 <title>
  description: string;
  path: string; // canonical 路徑，須以 / 開頭與結尾
  noindex?: boolean;
  jsonLd?: unknown[];
}
const { title, description, path, noindex = false, jsonLd = [] } = Astro.props;
const canonical = absUrl(path);
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {jsonLd.map((o) => <script type="application/ld+json" set:html={ldString(o)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-orange-200 bg-white">
      <div class="mx-auto max-w-4xl px-4 py-3 flex flex-wrap items-center justify-between gap-2">
        <a href="/" class="text-lg font-bold text-brand-dark">🏡 {SITE_NAME}</a>
        <nav aria-label="主要導覽" class="flex gap-4 text-sm">
          <a class="underline-offset-4 hover:underline" href="/chongyang-bonus/">重陽敬老金</a>
          <a class="underline-offset-4 hover:underline" href="/denture-subsidy/">假牙補助</a>
          <a class="underline-offset-4 hover:underline" href="/senior-card/">敬老卡</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-4xl flex-1 px-4 py-6">
      <slot />
    </main>
    <footer class="border-t border-orange-200 bg-orange-50 text-sm text-stone-600">
      <div class="mx-auto max-w-4xl px-4 py-6 space-y-1">
        <p>本站整理自各主管機關公開資訊，僅供參考；實際資格與金額以主管機關最新公告為準。</p>
        <p>本站不收集個人資料，試算皆在您的瀏覽器本機完成。</p>
        <p>插圖：<a class="underline" href={CREDIT.url} rel="noopener">{CREDIT.name}</a></p>
      </div>
    </footer>
  </body>
</html>
